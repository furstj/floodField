Title
    floodField configuration for tutorial case

Description
    Water level defined as scalar projection value along -g direction.
    With g = (0 0 -9.81), waterLevel = 5 means z = 5 m.
    Seed points are located outside the boat hull.

\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      floodFieldDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Water level as scalar projection along -g direction
// With gravity (0 0 -9.81), this corresponds to z = 5 m
waterLevel 5;

// Seed points guaranteed to be underwater and outside the boat hull
// Boat occupies: x: 4-6, y: 4-6, z: 2.5-7.5
seedPoints
(
    (9 9 2)      // Corner of domain, below water
);

