Title
    blockMeshDict for floodField tutorial

Description
    Creates a 10x10x10 m domain with a boat hull defined by STL.
    Water level at z = 5 m.

\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

vertices
(
    // Bottom corners (z = 0)
    (0 0 0)
    (10 0 0)
    (10 10 0)
    (0 10 0)

    // Top corners (z = 10)
    (0 0 10)
    (10 0 10)
    (10 10 10)
    (0 10 10)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 50 50) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type wall;
        faces
        (
            (0 4 7 3)
        );
    }

    right
    {
        type wall;
        faces
        (
            (1 5 6 2)
        );
    }

    back
    {
        type wall;
        faces
        (
            (3 2 6 7)
        );
    }

    front
    {
	type wall;
        faces
        (
            (0 1 5 4)
        );

    }

    bottom
    {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }

    top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);

